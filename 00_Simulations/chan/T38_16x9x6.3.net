* C:\users\ostoja\Desktop\02_Elektronika\flux_gate_current_sensor\simulations\chan\T38_16x9x6.3.asc
V1 drv 0 PULSE({-V_amp} {V_amp} 0 10n 10n {0.5 / fsw} {1 / fsw})
XU1 shunt_p drv P001 Winding n={N} L=10n Rs=1m Rp=100Meg
XU4 P001 Core_Chan Bs=0.43 Br=0.1 Hc=8 A={Ae} Lm={le} Lg=0 Rp=1Meg
R1 shunt_p 0 1
XU2 0 N006 P001 Winding n={1} L=10n Rs=1m Rp=100k
I1 0 N007 PULSE(0 100m 0 1u 1u 10m 20m)
V2 gate 0 PULSE(0 1 0 10n 10n {0.5 / 2 / fsw} {1 / 2/ fsw})
XU7 N002 0 op opamp Aol=100K GBW=10Meg
XU6 drv shunt_n P002 Winding n={N} L=10n Rs=1m Rp=100Meg
XU8 P002 Core_Chan Bs=0.43 Br=0.1 Hc=8 A={Ae} Lm={le} Lg=0 Rp=1Meg
R6 shunt_n 0 1
XU9 N006 N007 P002 Winding n={1} L=10n Rs=1m Rp=100k
XU3 N004 N005 e opamp Aol=100K GBW=10Meg
R3 e N004 100k
R7 N004 shunt_n 10k
R8 N005 shunt_p 10k
R9 0 N005 100k
XU10 N009 N008 P001 Winding n={N_comp} L=10n Rs=1m Rp=100Meg
XU11 N008 N001 P002 Winding n={N_comp} L=10n Rs=1m Rp=100Meg
R10 N009 0 1
B1 N003 0 V=V(e) * V(gate)
R5 N002 N003 10k
B2 N001 0 V=max(min(V(op), 5),-5)
C4 N002 op 10n
C3 N010 0 1n
R11 N009 N010 10k
.tran 0 1000m 0 10n
.param N=4 Ve=760n Ae=19.73u le=38.52m
.param Lm=10m
.param fsw = 75k
.param V_amp = 10
* T38 16x9x6.3
.param N_comp = 4
* T38 16x9x6.3
.lib Core_Chan.lib
.lib opamp.sub
.lib Winding.lib
.backanno
.end
